<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <groupId>org.openhab.ui.bundles</groupId>
  <artifactId>org.openhab.ui.neohab</artifactId>
  <version>1.37.0</version>
  <packaging>jar</packaging>

  <name>neohab</name>
  <description>A modern dashboard UI add-on for openHAB</description>

  <licenses>
    <license>
      <name>Eclipse Public License 2.0</name>
      <url>https://www.eclipse.org/legal/epl-2.0/</url>
    </license>
  </licenses>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- openHAB 3.x runs on Java 11. bnd turns this into Require-Capability osgi.ee, which is a
         hard resolution constraint, so 17 here locks the bundle out of every openHAB 3. -->
    <maven.compiler.release>11</maven.compiler.release>
    <!-- oldest supported openHAB core API line; runtime range is widened in bnd.bnd -->
    <ohc.version>4.3.11</ohc.version>
    <bnd.version>7.1.0</bnd.version>
    <node.version>v24.11.0</node.version>
    <npm.version>11.6.1</npm.version>
    <skipFrontend>false</skipFrontend>
    <!-- openHAB's own code style and static analysis, so this add-on is held to the same rules as
         one in the openhab-addons tree. sat.version also picks the openhab-codestyle artifact. -->
    <sat.version>0.18.0</sat.version>
    <spotless.version>2.44.3</spotless.version>
    <spotless.eclipse.version>4.25</spotless.eclipse.version>
    <spotless.eclipse.wtp.version>4.21.0</spotless.eclipse.wtp.version>
  </properties>

  <repositories>
    <repository>
      <id>openhab-release</id>
      <url>https://openhab.jfrog.io/artifactory/libs-release</url>
      <releases><enabled>true</enabled></releases>
      <snapshots><enabled>false</enabled></snapshots>
    </repository>
  </repositories>

  <dependencies>
    <dependency>
      <groupId>org.openhab.core.bundles</groupId>
      <artifactId>org.openhab.core.ui</artifactId>
      <version>${ohc.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.osgi</groupId>
      <!-- 1.4, not 1.5: the annotation version becomes a Require-Capability on the DS extender,
           and openHAB 3.x ships Felix SCR 2.1.x, which provides 1.4. Constructor injection, the
           only 1.4+ feature used here, is in 1.4. -->
      <artifactId>org.osgi.service.component.annotations</artifactId>
      <version>1.4.0</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.service.http.whiteboard</artifactId>
      <version>1.1.1</version>
      <scope>provided</scope>
    </dependency>
    <!-- for the cache-header filter. The Tomcat API is excluded because it declares the same
         JavaServlet contract, which bnd then refuses to resolve between. -->
    <dependency>
      <groupId>org.apache.felix</groupId>
      <artifactId>org.apache.felix.http.servlet-api</artifactId>
      <version>1.2.0</version>
      <scope>provided</scope>
      <exclusions>
        <exclusion>
          <groupId>org.apache.tomcat</groupId>
          <artifactId>tomcat-servlet-api</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>2.0.16</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.eclipse.jdt</groupId>
      <artifactId>org.eclipse.jdt.annotation</artifactId>
      <version>2.3.0</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.11.4</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>

      <!-- build the web app (Vite) before resources are collected -->
      <plugin>
        <groupId>com.github.eirslett</groupId>
        <artifactId>frontend-maven-plugin</artifactId>
        <version>1.15.1</version>
        <configuration>
          <workingDirectory>web</workingDirectory>
          <!-- persist node outside target/ so it survives `clean` for fast local iteration -->
          <installDirectory>.tools</installDirectory>
          <skip>${skipFrontend}</skip>
        </configuration>
        <executions>
          <execution>
            <id>install-node-and-npm</id>
            <goals><goal>install-node-and-npm</goal></goals>
            <phase>generate-resources</phase>
            <configuration>
              <nodeVersion>${node.version}</nodeVersion>
              <npmVersion>${npm.version}</npmVersion>
            </configuration>
          </execution>
          <execution>
            <id>npm-install</id>
            <goals><goal>npm</goal></goals>
            <phase>generate-resources</phase>
            <configuration>
              <arguments>install --no-audit --no-fund</arguments>
            </configuration>
          </execution>
          <execution>
            <id>npm-build</id>
            <goals><goal>npm</goal></goals>
            <phase>generate-resources</phase>
            <configuration>
              <arguments>run build</arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- pack the built web app into the jar under /web -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <goals><goal>add-resource</goal></goals>
            <phase>generate-resources</phase>
            <configuration>
              <resources>
                <resource>
                  <directory>web/dist</directory>
                  <targetPath>web</targetPath>
                </resource>
                <!-- MIT, Apache-2.0 and OFL all want their notices to travel with the bytes -->
                <resource>
                  <directory>${project.basedir}</directory>
                  <targetPath>META-INF</targetPath>
                  <includes>
                    <include>LICENSE</include>
                    <include>NOTICE</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- OSGi manifest + declarative services descriptors -->
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-maven-plugin</artifactId>
        <version>${bnd.version}</version>
        <executions>
          <execution>
            <goals><goal>bnd-process</goal></goals>
          </execution>
        </executions>
      </plugin>

      <!-- the Java side is small, but the cache rules are the part of it with decisions in it -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
      </plugin>

      <!-- openHAB's Eclipse formatter and import order, the same files the addons tree uses -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <eclipse>
              <file>openhab_codestyle.xml</file>
              <version>${spotless.eclipse.version}</version>
            </eclipse>
            <removeUnusedImports/>
            <importOrder>
              <file>openhab.importorder</file>
            </importOrder>
            <endWithNewline/>
          </java>
          <formats>
            <format>
              <includes>
                <include>src/**/*.xml</include>
              </includes>
              <eclipseWtp>
                <type>XML</type>
                <files>
                  <file>openhab_wst_xml_files.prefs</file>
                </files>
                <version>${spotless.eclipse.wtp.version}</version>
              </eclipseWtp>
              <trimTrailingWhitespace/>
              <endWithNewline/>
            </format>
          </formats>
        </configuration>
        <dependencies>
          <dependency>
            <groupId>org.openhab.tools</groupId>
            <artifactId>openhab-codestyle</artifactId>
            <version>${sat.version}</version>
          </dependency>
        </dependencies>
        <executions>
          <execution>
            <id>codestyle-check</id>
            <goals><goal>check</goal></goals>
            <phase>initialize</phase>
          </execution>
        </executions>
      </plugin>

      <!-- openHAB's static analysis: checkstyle, PMD and SpotBugs against their rulesets.
           Report lands in target/code-analysis/report.html; an error-priority finding fails. -->
      <plugin>
        <groupId>org.openhab.tools.sat</groupId>
        <artifactId>sat-plugin</artifactId>
        <version>${sat.version}</version>
        <configuration>
          <checkstyleProperties>${project.basedir}/tools/static-code-analysis/checkstyle/ruleset.properties</checkstyleProperties>
          <checkstyleFilter>${project.basedir}/tools/static-code-analysis/checkstyle/suppressions.xml</checkstyleFilter>
        </configuration>
        <executions>
          <execution>
            <id>sat-all</id>
            <goals>
              <goal>checkstyle</goal>
              <goal>pmd</goal>
              <goal>spotbugs</goal>
              <goal>report</goal>
            </goals>
            <phase>verify</phase>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <archive>
            <manifestFile>${project.build.outputDirectory}/META-INF/MANIFEST.MF</manifestFile>
          </archive>
        </configuration>
      </plugin>

    </plugins>

    <extensions>
      <extension>
        <groupId>org.openhab.tools.sat</groupId>
        <artifactId>sat-extension</artifactId>
        <version>${sat.version}</version>
      </extension>
    </extensions>
  </build>

</project>
