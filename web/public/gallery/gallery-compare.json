{
  "version": 1,
  "id": "gallery-compare",
  "name": "Two readings side by side",
  "kind": "template",
  "source": "gallery",
  "settings": [
    {
      "id": "itemA",
      "type": "item",
      "label": "Left item"
    },
    {
      "id": "labelA",
      "type": "string",
      "label": "Left caption"
    },
    {
      "id": "itemB",
      "type": "item",
      "label": "Right item"
    },
    {
      "id": "labelB",
      "type": "string",
      "label": "Right caption"
    }
  ],
  "template": "<div class=\"cmp\">\n  <div class=\"cmp__side\">\n    <div class=\"cmp__v\">{{ getItem(config.itemA).displayState || itemValue(config.itemA) || '-' }}</div>\n    <div class=\"cmp__l\">{{ config.labelA }}</div>\n  </div>\n  <div class=\"cmp__sep\"></div>\n  <div class=\"cmp__side\">\n    <div class=\"cmp__v\">{{ getItem(config.itemB).displayState || itemValue(config.itemB) || '-' }}</div>\n    <div class=\"cmp__l\">{{ config.labelB }}</div>\n  </div>\n</div>\n<style>\n  .cmp { display: flex; align-items: stretch; height: 100%; }\n  .cmp__side { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center;\n    justify-content: center; gap: 2px; }\n  .cmp__v { font-size: 1.6em; font-weight: 700; line-height: 1; }\n  .cmp__l { font-size: 0.75em; opacity: 0.7; text-align: center; overflow: hidden; text-overflow: ellipsis;\n    white-space: nowrap; max-width: 100%; }\n  .cmp__sep { flex: 0 0 1px; background: var(--nh-border); margin: 6px 4px; }\n</style>"
}
