# Copy to .env.local (gitignored) and point at a real openHAB.
#
# The dev server proxies /rest, /auth, /icon/, /static and /images to this address, so `npm run
# dev` runs the frontend against your real items with no Java build. Reading works anonymously;
# editing needs an administrator sign-in inside the app.
OPENHAB_URL=http://localhost:8080
