    "jsep": "^1.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.10",
    "uplot": "^1.6.32",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@iconify-json/flat-color-icons": "^1.2.3",
