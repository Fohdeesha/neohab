{
  "name": "neohab-web",
  "private": true,
  "version": "1.16.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/stage-assets.mjs && node scripts/build-docs.mjs",
    "dev": "vite",
    "prebuild": "node scripts/stage-assets.mjs && node scripts/build-docs.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
