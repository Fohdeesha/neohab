!.env.example
*.tsbuildinfo

# --- frontend toolchain (maven-installed node) ---
.tools/
web/node/

# --- e2e (local target config + run artifacts) ---
e2e/target.*.json
!e2e/target.example.json
e2e/*.png
e2e/*.json.bak
e2e/snapshot*.json
