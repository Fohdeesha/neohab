# from their npm packages (see web/scripts/)
web/public/docs/
web/public/icons/
web/public/fonts/
*.local
npm-debug.log*
yarn-error.log*

# --- Java / Maven ---
target/
.classpath
.project
.settings/
*.class
*.jar
!.mvn/wrapper/*.jar

# --- IDE / tooling ---
.idea/
*.iml
.vscode/*
!.vscode/extensions.json

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- secrets ---
*.key
*.pem
id_rsa*
id_ed25519*

# --- misc ---
*.log
.env
.env.*
