Bundle-SymbolicName: ${project.artifactId}
Bundle-Name: neohab
Bundle-Vendor: neohab
Automatic-Module-Name: org.openhab.ui.neohab

# bnd would otherwise pin an osgi.contract to the exact servlet version it compiled against, and
# no other openHAB line would then resolve the bundle. The widened imports below do the job.
-contract: -*

# compiled against 4.3.x, must resolve on 3.1 through 5.x, so the ranges are widened by hand.
# openHAB exports this package at its own release version, so the floor here IS the oldest
# openHAB that can load the bundle - 3.1, where the tiles package first appeared.
Import-Package: \
  org.openhab.core.ui.tiles;version="[3.1,6)",\
  javax.servlet;version="[3.1,6)",\
  javax.servlet.http;version="[3.1,6)",\
  org.slf4j;version="[1.7,3)",\
  *

-noimportjava: true
-sources: false
